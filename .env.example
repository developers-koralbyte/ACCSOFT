# Leave everything blank to run in demo mode.

# Real document extraction (Claude). Without this the app returns realistic sample data.
ANTHROPIC_API_KEY=

# Xero OAuth app: create at https://developer.xero.com/app/manage
# Redirect URI must be exactly: http://localhost:3000/api/xero/callback (and your Vercel URL later)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:3000/api/xero/callback
